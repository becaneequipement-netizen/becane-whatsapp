{
  "name": "becane-whatsapp",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "achat.becaneetequipement.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "becane-equipement",
      "database_id": "075e4a71-0bc6-4e7a-81e6-0ac865e7011f"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
